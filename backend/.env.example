PORT=5000
# Default: MongoDB Community lokal (instal di server sekolah, tanpa internet sama sekali
# setelah setup awal). Lihat README bagian "Deployment untuk Sekolah 3T (Tanpa Internet)".
MONGO_URI=mongodb://localhost:27017/edunusa
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d

# --- Opsional: pakai MongoDB Atlas (cloud) untuk dev di komputer yang online ---
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edunusa
# Kalau muncul error "querySrv ECONNREFUSED" saat connect ke Atlas, backend otomatis memakai
# DNS publik (1.1.1.1, 8.8.8.8) untuk resolve mongodb+srv://. Ganti daftar server di bawah bila
# perlu, atau set DNS_OVERRIDE=false untuk memakai resolver DNS sistem apa adanya. Ini TIDAK
# berpengaruh sama sekali untuk MONGO_URI lokal (mongodb://) di atas.
# DNS_OVERRIDE=false
# DNS_SERVERS=1.1.1.1,8.8.8.8

OLLAMA_HOST=http://localhost:11434
# Nama model Ollama untuk AI Tutor (lihat /edunusa-model). Ganti saat testing model versi lain.
EDUNUSA_MODEL=edunusa

# Kosongkan/hapus baris ini (atau isi "*") untuk deployment LAN sekolah agar diakses dari IP
# device siswa manapun. Isi origin spesifik hanya kalau backend & frontend sengaja dipisah proses.
CORS_ORIGIN=http://localhost:5173
